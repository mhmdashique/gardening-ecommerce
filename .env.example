# ---------------------------------------------------------------------------
# Leaf & Pot environment variables
# Copy to .env.local and fill in. The app runs in local demo mode if Supabase
# variables are missing (see ASSUMPTIONS.md). Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only fallbacks (used when the NEXT_PUBLIC_* variants are absent)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Cashfree (Merchant Dashboard -> API keys / Webhooks)
# App ID + Secret Key are required for online payments.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional legacy keys.
CASHFREE_API_KEY=
NEXT_PUBLIC_CASHFREE_API_KEY=
CASHFREE_WEBHOOK_SECRET=
# sandbox (default) or production. Case-insensitive.
CASHFREE_ENV=

# Signs short-lived online-checkout intents. Falls back to the Cashfree webhook
# secret or the Supabase service-role key when omitted.
CHECKOUT_INTENT_SECRET=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Leaf & Pot <orders@leafandpot.in>"

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local demo-mode session signing secret (ignored when Supabase is configured)
DEMO_SESSION_SECRET=change-me-in-local-development
